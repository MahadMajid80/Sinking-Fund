# ---------------------------------------------------------------------------
# Sinking Fund - environment configuration
# Copy to .env.local (local) or set in your hosting dashboard. Never commit real values.
# All variables are server-side only. None are exposed to the browser.
# SITE_URL and SITE_INDEXABLE are read at BUILD time: rebuild after changing them.
# ---------------------------------------------------------------------------

# Canonical production origin, no trailing slash. OWNER INPUT REQUIRED:
# confirm www vs non-www and the trailing-slash convention against the live site / Search Console.
SITE_URL=https://www.sinkingfund.com.au

# Only "true" on the confirmed production deployment. Anything else = noindex, nofollow,
# X-Robots-Tag header, robots.txt Disallow: /, and an empty sitemap (safe for previews).
SITE_INDEXABLE=false

# Redirect other hosts and plain HTTP to SITE_URL in the same hop as legacy redirects.
# Enable on production once DNS for all hostnames points at this deployment.
ENFORCE_CANONICAL_HOST=false

# ---------------------------------------------------------------------------
# Mail (OWNER INPUT REQUIRED: provider, verified sender and enquiry inboxes)
# ---------------------------------------------------------------------------
# smtp = real delivery | mock = write JSON to MAIL_MOCK_DIR (tests/local only, nothing is sent)
# Leave unset and the forms show "online enquiries are unavailable, please call" instead of
# pretending to succeed.
MAIL_TRANSPORT=smtp

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS); false/omitted for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Verified sender on a domain with SPF/DKIM configured for SMTP_HOST.
MAIL_FROM="Sinking Fund website <website@example.com.au>"

# Recipients (comma separated). ENQUIRY_TO is the fallback when a form-specific list is empty.
CONTACT_TO=
QUOTE_TO=
ENQUIRY_TO=

# Mock transport output directory (tests).
MAIL_MOCK_DIR=.mail-outbox

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Defaults: 5 submissions per form, per client IP, per 10 minutes.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
# Optional shared store for serverless / multi-instance hosting (e.g. Vercel). Without these,
# limits are kept in memory per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
